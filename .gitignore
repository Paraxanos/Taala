# Password data never enters git. See OPEN_SOURCE.md §4.
data/raw/
data/splits/*.tsv
data/private/
*rockyou*
*-withcount*

# Survey raw responses (the cleaned variant tables are committed; raw exports are not)
data/survey_raw/
results/private/

# Generated word lists: Wikipedia-derived, rebuildable with tools/fetch_wordlists.py.
# pack.toml (committed) records which categories produced each file. See data/LICENSE-DATA.md.
locales/*/words/*.txt

# Survey instrument documents: the survey has not been run, so these stay local.
# survey/words.tsv, split.tsv and FREEZE.json are NOT ignored: the rule learner, the
# word-list builder and the tests read them.
survey/README.md
survey/consent.md
survey/instructions.md
survey/cleaning_rules.md

# Run logs (results/*.json and *.md hold the aggregates and are committed)
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep these, despite the rules above
!data/splits/MANIFEST.json
